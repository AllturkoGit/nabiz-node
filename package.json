{
    "name": "@allturko/nabiz-node",
    "version": "0.2.1",
    "description": "Nabız Hub için Node.js raporlayıcı — sunucu hataları, SSR hataları, yavaş istekler",
    "license": "MIT",
    "author": "AllTurko",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AllturkoGit/nabiz-node.git"
    },
    "engines": {
        "node": ">=18.17"
    },
    "main": "src/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./src/index.js"
        },
        "./express": "./src/express.js",
        "./next": "./src/next.js",
        "./auto": "./src/auto.js"
    },
    "bin": {
        "nabiz-durum": "bin/nabiz-durum.js"
    },
    "files": [
        "src",
        "bin",
        "types",
        "README.md"
    ],
    "scripts": {
        "test": "node --test test/"
    },
    "keywords": [
        "monitoring",
        "error-tracking",
        "nextjs",
        "express",
        "nabiz"
    ]
}
